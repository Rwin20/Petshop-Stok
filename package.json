{
  "name": "petshop-stok",
  "version": "1.0.13",
  "description": "Petshop Stok ve Satış Takip Uygulaması",
  "main": "electron/main.js",
  "author": "PetshopStok",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rwin20/Petshop-Stok.git"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "npm run build:vite && npm run build:electron",
    "build:vite": "vite build",
    "build:electron": "electron-builder --win --x64",
    "preview": "vite preview"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.13.5",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "cheerio": "^1.2.0",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.344.0",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sql.js": "^1.10.0",
    "whatsapp-web.js": "^1.34.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "node-forge": "^1.3.3",
    "postcss": "^8.4.35",
    "selfsigned": "^5.5.0",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.petshop.stok",
    "productName": "Petshop Stok",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Rwin20",
        "repo": "Petshop-Stok"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Petshop Stok",
      "artifactName": "Petshop Setup ${version}.exe"
    },
    "asar": true
  }
}
